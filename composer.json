{
  "name": "udir/kpas",
  "type": "project",
  "description": "KompetansePortal Administrative System",
  "keywords": [
    "kpas",
    "udir"
  ],
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/matematikk-mooc/lti-1-3-php-library"
    }
  ],
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "dompdf/dompdf": "^v3.1.4",
    "easyrdf/easyrdf": "^1.1",
    "guzzlehttp/guzzle": "^7.10.0",
    "highsolutions/laravel-environments": "*",
    "imsglobal/lti-1p3-tool": "dev-master",
    "laravel/framework": "v11.47.0",
    "laravel/tinker": "^v2.10.2",
    "league/oauth2-client": "^2.9.0",
    "mantas-done/subtitles": "^1.0.22",
    "nesbot/carbon": "^3.11.0",
    "sentry/sentry-laravel": "^4.20.0",
    "spatie/laravel-data": "^4.18.0",
    "spatie/laravel-ignition": "^2.8",
    "symfony/polyfill-iconv": "^v1.33.0",
    "vimeo/laravel": "^5.9"
  },
  "require-dev": {
    "barryvdh/laravel-debugbar": "^v3.16.3",
    "beyondcode/laravel-dump-server": "^2.0",
    "filp/whoops": "^2.18.4",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^v8.8.3"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "App\\Models\\": "app/Models/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/",
      "IMSGlobal\\": "IMSGlobal/"
    },
    "files": [
      "app/Utils/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi"
    ]
  }
}
